rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images live under the owner's UID. Only the authenticated owner may
    // upload; the owner may also read (which is what lets their images render
    // on their other devices).
    match /users/{userId}/images/{imageName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
